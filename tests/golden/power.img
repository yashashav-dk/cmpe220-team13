T13IMG 1
ENTRY 0000
SYM main 0000
SYM loop 000C
SYM done 001E
SYM result 0100
SEG TEXT 0000
0000: 1100 0001      ; MOV R0, #1
0004: 1110 0008      ; MOV R1, #8
0008: 1120 0002      ; MOV R2, #2
000C: A120 0000      ; CMP R2, #0
0010: B100 001E      ; JEQ 0x001E
0014: 4001           ; MUL R0, R1
0016: 3120 0001      ; SUB R2, #1
001A: B000 000C      ; JMP 0x000C
001E: 1700 0100      ; MOV [0x0100], R0
0022: 0000           ; HALT
SEG DATA 0100
0100: 0000           ; result
